// heroes3.rc - the retail HEROES3.EXE resources as source.
//
// Compiled by the pinned VC6 SP3 RC.EXE and gated payload for payload
// against the retail image (homm3.build.resources); LINK converts the .res
// with the pinned CVTRES 5.00.1736, whose objects carry @comp.id 6/1735 as
// retail's Rich header records. Statement order is retail payload order.
// The retail image names no resource IDs, so the command IDs stay numbers.
// heroes3.ico is the one binary input: the build rebuilds it from the
// user's HEROES3.EXE in a temporary stage beside a copy of this file.

#include <windows.h>

115 ICON "heroes3.ico"

103 DIALOG 22, 17, 242, 133
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION
FONT 10, "MS Sans Serif"
BEGIN
    ICON            "HEROES", -1, 8, 19, 20, 20
    CTEXT           "Heroes of Might and Magic III Complete", 32768, 31, 8, 178, 8
    CTEXT           "Version 4.0", 32769, 73, 21, 94, 10
    CTEXT           "\251 2000 The 3DO Company. All Rights Reserved.", 32771, 26, 36, 189, 8
    CTEXT           "New World Computing is a division of The 3DO Company.", -1, 26, 90, 189, 18
    DEFPUSHBUTTON   "OK", 1, 96, 110, 48, 14, WS_GROUP
    CTEXT           "3DO, Heroes, Heroes of Might and Magic, Armageddon's Blade, Shadow of Death, New World Computing, and their respective logos, are trademarks and/or service marks of The 3DO Company in the U.S. and other countries.", -1, 26, 44, 189, 40
    CTEXT           "All other trademarks belong to their respective owners.", -1, 26, 76, 189, 8
END

