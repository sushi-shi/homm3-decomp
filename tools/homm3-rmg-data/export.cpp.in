#undef DATA_COMPGEN
template <unsigned N>
static void emitNames(const char* name, const char* const (&values)[N]) {
    std::printf("pub const %s: [&[u8]; %u] = [", name, N);
    for (auto value : values) std::printf("b\"%s\",", value);
    std::printf("];\n");
}

