# generated by homm3.build.configure from config/units.toml - do not edit
builddir = build
rule configure
  command = PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=scripts python3 -m $
      homm3.build.configure
  description = CONFIGURE
  generator = 1
rule cl
  command = PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=scripts python3 -m $
      homm3.core.cc_wrap --out $object --src $in -- $flags
  description = VC6 $unit
  depfile = $object.d
  deps = gcc
rule link
  command = PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=scripts python3 -m $
      homm3.build.link --out $out
  description = LINK $out
build build.ninja: configure config/units.toml config/project.toml | $
    scripts/homm3/build/configure.py $
    scripts/homm3/build/compilation_database.py scripts/homm3/core/clang.py $
    scripts/homm3/core/compiler_profile.py scripts/homm3/core/project.py $
    scripts/homm3/build/ninja_syntax.py
build build/objdiff/base/adler32.obj | $
    build/objdiff/base/adler32.obj.compile.json: cl $
    vendor/zlib-1.1.3/adler32.c | scripts/homm3/core/cc_wrap.py $
    scripts/homm3/core/project.py scripts/homm3/build/compiled_freshness.py $
    config/units.toml config/project.toml
  object = build/objdiff/base/adler32.obj
  flags = /nologo /c /O2 /ML /Gr /TC /D_WINDOWS
  unit = adler32
build adler32: phony build/objdiff/base/adler32.obj
