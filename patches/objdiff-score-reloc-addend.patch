+// A same-named pool symbol at a different section offset must not rescue a
+// different absolute addend. Keep the pool/name-address and REL32 controls.
+#[test]
+#[cfg(feature = "x86")]
+fn diff_absolute_addend_in_code_and_data() {
+    use obj::{Relocation, RelocationFlags, Section, SectionData, SectionKind, Symbol, SymbolKind};
+    fn fixture(base: bool, flags: u16) -> obj::Object {
+        let mut object = obj::read::parse(
+            include_object!("data/x86/rtest.obj"),
+            &diff::DiffObjConfig::default(),
+            diff::DiffSide::Base,
+        ).unwrap();
+        let relocation = Relocation {
+            flags: RelocationFlags::Coff(flags), address: 1, target_symbol: 1,
+            addend: if base { 0 } else { 4 },
+        };
+        object.sections = vec![
+            Section {
+                id: ".text".into(), name: ".text".into(), size: 6,
+                kind: SectionKind::Code,
+                data: SectionData(vec![0xb8, 0, 0, 0, 0, 0xc3]),
+                relocations: vec![relocation.clone()], ..Default::default()
+            },
+            Section {
+                id: ".data".into(), name: ".data".into(), size: 8,
+                kind: SectionKind::Data, data: SectionData(vec![0; 8]),
+                relocations: vec![Relocation { address: 0, ..relocation }],
+                ..Default::default()
+            },
+        ];
+        object.symbols = vec![
+            Symbol { name: "function".into(), size: 6, kind: SymbolKind::Function,
+                     section: Some(0), ..Default::default() },
+            Symbol { name: "table".into(), address: if base { 4 } else { 0 },
+                     size: if base { 0 } else { 4 }, kind: SymbolKind::Object,
+                     section: Some(1), ..Default::default() },
+        ];
+        object
+    }
+    let config = diff::DiffObjConfig {
+        function_reloc_diffs: diff::FunctionRelocDiffs::All, ..Default::default()
+    };
+    let scores = |target: &obj::Object, base: &obj::Object| {
+        let code = diff::code::diff_code(target, base, 0, 0, &config).unwrap().0;
+        let data = diff::data::diff_data_section(
+            target, base, &Default::default(), &Default::default(), 1, 1,
+        ).unwrap().0;
+        (code.match_percent.unwrap(), data.match_percent.unwrap())
+    };
+    let target = fixture(false, object::pe::IMAGE_REL_I386_DIR32);
+    assert_eq!(scores(&target, &target), (100.0, 100.0));
+    let mut base = fixture(true, object::pe::IMAGE_REL_I386_DIR32);
+    let (code, data) = scores(&target, &base);
+    assert!(code < 100.0, "wrong absolute addend in code scored exact");
+    assert!(data < 100.0, "wrong absolute addend in data scored exact");
+    // A differently named pool can legitimately encode the same byte.
+    base.symbols[1].name = "pool".into();
+    assert_eq!(scores(&target, &base), (100.0, 100.0));
+    let target = fixture(false, object::pe::IMAGE_REL_I386_REL32);
+    let base = fixture(true, object::pe::IMAGE_REL_I386_REL32);
+    assert_eq!(scores(&target, &base), (100.0, 100.0));
+}
