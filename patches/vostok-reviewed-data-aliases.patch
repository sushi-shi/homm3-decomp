     #[test]
+    fn reviewed_alias_preserves_interior_and_one_past_owner() {
+        let data = parse(&manifest("a.c\t0x100\t0x20\tdata\t4\t-\t-\tlocal")).unwrap();
+        let name = RawString::from(&b"table"[..]);
+        let other = RawString::from(&b"wrong"[..]);
+        for addend in [0, 4, 0x20] {
+            assert!(crate::relocs::reviewed_alias(&data, 0x100 + addend, addend as u32, name));
+        }
+        assert!(!crate::relocs::reviewed_alias(&data, 0x121, 0x21, name));
+        assert!(!crate::relocs::reviewed_alias(&data, 0x100, 0, other));
+        assert!(!crate::relocs::reviewed_alias(&data, 0x104, 0, name));
+        assert!(!crate::relocs::reviewed_alias(&data, 0, 1, name));
+        assert!(!crate::relocs::reviewed_alias(&DataManifest::default(), 0x100, 0, name));
+    }
