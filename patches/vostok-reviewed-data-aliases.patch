+// Reviewed aliases may point one-past an allocation. Resolve their explicit
+// owner first, rather than materializing another four-byte fallback copy.
+pub(crate) fn reviewed_alias(
+    manifest: &DataManifest,
+    target_rva: usize,
+    addend: u32,
+    name: RawString<'static>,
+) -> bool {
+    target_rva.checked_sub(addend as usize)
+        .and_then(|rva| manifest.owner_and_addend_for_rva(rva))
+        .is_some_and(|(owner, offset)| offset == 0
+            && owner.symbol_name == name && addend as usize <= owner.size)
 }
 
