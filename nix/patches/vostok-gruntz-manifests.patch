+    #[test]
+    fn admitted_alias_owner_is_referenced_for_interior_and_bound_addresses() {
+        use crate::data_manifest::{DataDefinition, DataScope, DataStorage};
+        let owner = RawString::from(&b"table"[..]);
+        for storage in [DataStorage::Data, DataStorage::Rdata, DataStorage::Bss] {
+            let definitions = [DataDefinition {
+                symbol_name: owner, object: b"owner.c", rva: 0x4000, size: 16,
+                storage, alignment: 4, section_ordinal: None, section_offset: None,
+                scope: DataScope::External,
+            }];
+            // Start, interior, one-past, field-past-end and negative offset.
+            for addend in [0u32, 4, 16, 20, (-4i32) as u32] {
+                let target = 0x4000u32.wrapping_add(addend) as usize;
+                for is_static in [false, true] {
+                    assert!(matches!(alias_data_kind(&definitions, owner, addend, target, is_static),
+                        RelocKind::ReviewedData { symbol } if symbol == owner));
+                }
+            }
+            // A coincident name or a containing definition is not enough.
+            assert!(matches!(alias_data_kind(&definitions, owner, 0, 0x4004, true),
+                RelocKind::ConjuredStatic { .. }));
+            assert!(matches!(alias_data_kind(&definitions, RawString::from(&b"other"[..]), 0, 0x4000, false),
+                RelocKind::ConjuredConstant { .. }));
+        }
+        assert!(matches!(alias_data_kind(&[], owner, 4, 0x4004, true),
+            RelocKind::ConjuredStatic { .. }));
+        assert!(matches!(alias_data_kind(&[], owner, 4, 0x4004, false),
+            RelocKind::ConjuredConstant { .. }));
+    }
