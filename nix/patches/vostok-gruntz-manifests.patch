+// An alias selects a source owner, even when the target is a one-past or
+// field-past-end loop bound. If that owner has an admitted definition, reference
+// it rather than fabricating a second four-byte definition under the same name.
+// resolve_manifest_alias already proves the PDB owner and wrapping RVA sum;
+// require the data manifest to agree on both its base address and identity.
+fn alias_data_kind(
+    definitions: &[crate::data_manifest::DataDefinition],
+    owner: RawString<'static>,
+    addend: u32,
+    target_rva: usize,
+    is_static: bool,
+) -> RelocKind<'static> {
+    let owner_rva = (target_rva as u32).wrapping_sub(addend) as usize;
+    if definitions.iter().any(|definition|
+        definition.rva == owner_rva && definition.symbol_name == owner)
+    {
+        RelocKind::ReviewedData { symbol: owner }
+    } else if is_static {
+        RelocKind::ConjuredStatic { symbol: owner, target_rva }
+    } else {
+        RelocKind::ConjuredConstant { symbol: owner, target_rva }
+    }
 }

